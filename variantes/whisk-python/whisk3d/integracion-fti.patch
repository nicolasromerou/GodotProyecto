+static bool ProcesarControlFti(const SDL_Event& e) {
+    if (!W3dFtiActivo()) return false;
+    if ((e.type == SDL_MOUSEBUTTONDOWN || e.type == SDL_MOUSEBUTTONUP) && e.button.button == SDL_BUTTON_MIDDLE)
+        return true;
+    if (e.type == SDL_MOUSEMOTION && (e.motion.state & SDL_BUTTON_MMASK)) {
+        if (e.motion.xrel != 0) W3dFtiPedir(FtiGiro, -e.motion.xrel);
+        if (e.motion.yrel != 0) W3dFtiPedir(FtiInclinacion, e.motion.yrel);
+        return true;
+    }
+    if (e.type == SDL_MOUSEWHEEL && e.wheel.y != 0) {
+        const int steps = e.wheel.direction == SDL_MOUSEWHEEL_FLIPPED ? -e.wheel.y : e.wheel.y;
+        W3dFtiPedir(FtiZoom, steps * 10);
+        return true;
+    }
+    if ((e.type != SDL_KEYDOWN && e.type != SDL_KEYUP) ||
+        (e.key.keysym.mod & (KMOD_CTRL | KMOD_ALT | KMOD_GUI))) return false;
+    const SDL_Keycode key = e.key.keysym.sym;
+    W3dFtiAccion action;
+    int value = 0;
+    switch (key) {
+        case SDLK_SPACE: case SDLK_ESCAPE: action = FtiPausa; break;
+        case SDLK_r: action = FtiReinicio; break;
+        case SDLK_s: action = FtiSensores; break;
+        case SDLK_p: action = FtiPeaton; break;
+        case SDLK_LEFT: action = FtiGiro; value = -10; break;
+        case SDLK_RIGHT: action = FtiGiro; value = 10; break;
+        case SDLK_UP: action = FtiInclinacion; value = 5; break;
+        case SDLK_DOWN: action = FtiInclinacion; value = -5; break;
+        default:
+            if (key >= SDLK_1 && key <= SDLK_4) { action = FtiVista; value = key - SDLK_1; }
+            else if (key >= SDLK_F5 && key <= SDLK_F8) { action = FtiModo; value = key - SDLK_F5; }
+            else if (key >= SDLK_F9 && key <= SDLK_F12) { action = FtiEscenario; value = key - SDLK_F9; }
+            else return false;
+    }
+    if (e.type == SDL_KEYDOWN && (!e.key.repeat || action == FtiGiro || action == FtiInclinacion))
+        W3dFtiPedir(action, value);
+    return true;
+}
