+#include <string.h>
+#include <deque>
+#endif
+
 extern "C" {
 #include "lua.h"
 #include "lauxlib.h"
 }
 
+#if defined(_WIN32)
+namespace {
+const DWORD FtiFrameSize = 16384;
+const DWORD FtiAckSize = 256;
+const DWORD FtiAckOffset = sizeof(DWORD) + FtiFrameSize;
+const DWORD FtiInputOffset = FtiAckOffset + sizeof(DWORD) + FtiAckSize;
+const DWORD FtiInputCapacity = 128;
+struct FtiInput { LONG action; LONG value; };
+
+struct FtiChannel {
+    HANDLE mapping;
+    HANDLE mutex;
+    unsigned char* memory;
+    bool paused;
+    std::string title;
+    std::deque<FtiInput> pending;
+    FtiChannel() : mapping(NULL), mutex(NULL), memory(NULL), paused(true), title("FTI | Conectando") {}
+    ~FtiChannel() {
+        if (memory) UnmapViewOfFile(memory);
+        if (mutex) CloseHandle(mutex);
+        if (mapping) CloseHandle(mapping);
+    }
+    bool lock() const {
+        const DWORD result = WaitForSingleObject(mutex, 0);
+        return result == WAIT_OBJECT_0 || result == WAIT_ABANDONED;
+    }
+} fti;
+
+int LFtiRead(lua_State* L) {
+    char frame[FtiFrameSize];
+    DWORD size = 0;
+    if (fti.lock()) {
+        memcpy(&size, fti.memory, sizeof(size));
+        if (size <= FtiFrameSize) memcpy(frame, fti.memory + sizeof(size), size);
+        ReleaseMutex(fti.mutex);
+    }
+    if (size == 0 || size > FtiFrameSize) lua_pushnil(L);
+    else lua_pushlstring(L, frame, size);
+    return 1;
+}
+
+int LFtiAck(lua_State* L) {
+    size_t size = 0;
+    const char* text = luaL_checklstring(L, 1, &size);
+    fti.paused = lua_toboolean(L, 2) != 0;
+    fti.title = luaL_optstring(L, 3, "FTI");
+    const bool ok = size <= FtiAckSize && fti.lock();
+    if (ok) {
+        const DWORD length = (DWORD)size;
+        memcpy(fti.memory + FtiAckOffset + sizeof(length), text, size);
+        memcpy(fti.memory + FtiAckOffset, &length, sizeof(length));
+        ReleaseMutex(fti.mutex);
+    }
+    lua_pushboolean(L, ok);
+    return 1;
+}
+}
+
+bool W3dFtiActivo() { return fti.memory != NULL; }
+bool W3dFtiPausado() { return fti.paused; }
+const char* W3dFtiTitulo() { return fti.title.c_str(); }
+
+void W3dFtiEnviarAcciones() {
+    if (!fti.memory || fti.pending.empty() || !fti.lock()) return;
+    DWORD count = 0;
+    memcpy(&count, fti.memory + FtiInputOffset, sizeof(count));
+    if (count > FtiInputCapacity) count = 0;
+    while (count < FtiInputCapacity && !fti.pending.empty()) {
+        memcpy(fti.memory + FtiInputOffset + sizeof(count) + count * sizeof(FtiInput),
+               &fti.pending.front(), sizeof(FtiInput));
+        ++count;
+        fti.pending.pop_front();
+    }
+    memcpy(fti.memory + FtiInputOffset, &count, sizeof(count));
+    ReleaseMutex(fti.mutex);
+}
+
+void W3dFtiPedir(W3dFtiAccion accion, int valor) {
+    if (!fti.memory) return;
+    FtiInput item = { (LONG)accion, (LONG)valor };
+    fti.pending.push_back(item);
+    W3dFtiEnviarAcciones();
+}
+
+bool W3dFtiOpen(const char* channel) {
+    const std::string name(channel);
+    if (fti.memory || name.size() != 42 || name.compare(0, 10, "Local\\FTI_") != 0 ||
+        name.find_first_not_of("0123456789abcdef", 10) != std::string::npos) return false;
+    fti.mapping = OpenFileMappingA(FILE_MAP_WRITE, FALSE, channel);
+    if (!fti.mapping) return false;
+    fti.mutex = OpenMutexA(SYNCHRONIZE | MUTEX_MODIFY_STATE, FALSE, (name + "_mtx").c_str());
+    if (!fti.mutex) return false;
+    fti.memory = (unsigned char*)MapViewOfFile(fti.mapping, FILE_MAP_WRITE, 0, 0,
+                                              FtiInputOffset + sizeof(DWORD) + FtiInputCapacity * sizeof(FtiInput));
+    return fti.memory != NULL;
+}
+#endif
