# Copiar como .env en esta misma carpeta y completar. .env está en .gitignore: nunca se sube.
# Sin estas dos variables la maqueta funciona igual y simplemente no envía datos.

# Dirección completa de la ruta de ingesta de la web. Debe usar https, salvo que la
# web corra en este mismo equipo (http://localhost:3000/api/ingesta).
INGESTA_URL=
# Token del cruce. Lo entrega quien administra la web; es el INGESTA_TOKEN de su .env.
INGESTA_TOKEN=
# Opcional. Identificador del cruce en la web; por defecto maqueta-01 (el cruce I-5).
# INGESTA_CRUCE=maqueta-01
